{
  "name": "@local/dsh-session-tags",
  "version": "1.2.1",
  "private": true,
  "description": "Persistent custom session sections above collapsible workspaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xty13114150041/dsh-session-tags.git"
  },
  "homepage": "https://github.com/xty13114150041/dsh-session-tags#readme",
  "bugs": { "url": "https://github.com/xty13114150041/dsh-session-tags/issues" },
  "engines": { "dsh": "^0.2.1-rc.5" },
  "scripts": {
    "test": "node --test model.test.js client.test.js host.test.js",
    "check": "node --check client.js && node --check host.js && node --check model.js"
  },
  "type": "module",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["host.js", "model.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.en.md", "LICENSE"],
  "dependencies": { "zod": "^4.0.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
